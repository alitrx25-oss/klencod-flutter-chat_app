rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().isAdmin == true; }
    function notBanned() { return signedIn() && me().banned != true; }

    match /users/{uid} {
      allow read: if signedIn();
      // التسجيل: لا يمكن للمستخدم أن يجعل نفسه أدمن أو محظورًا
      allow create: if request.auth.uid == uid
                    && request.resource.data.isAdmin == false
                    && request.resource.data.banned == false;
      // تعديل الاسم والصورة فقط للمستخدم، والأدمن يعدّل كل شيء
      allow update: if (request.auth.uid == uid
                    && request.resource.data.isAdmin == resource.data.isAdmin
                    && request.resource.data.banned == resource.data.banned)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if notBanned()
                    && request.auth.uid in chatId.split('_')
                    && request.auth.uid in request.resource.data.members;
      allow update: if notBanned() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if notBanned()
                      && request.auth.uid in chatId.split('_')
                      && request.resource.data.senderId == request.auth.uid;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
